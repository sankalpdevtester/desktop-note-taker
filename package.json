{
  "name": "desktop-note-taker",
  "version": "1.0.0",
  "description": "A modern desktop note-taking application built with Electron and TypeScript",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "build": "tsc",
    "dev": "tsc && electron .",
    "package": "electron-builder",
    "watch": "tsc --watch"
  },
  "keywords": [
    "electron",
    "notes",
    "productivity",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "marked": "^9.1.0"
  },
  "build": {
    "appId": "com.notes.desktop",
    "productName": "Desktop Note Taker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
